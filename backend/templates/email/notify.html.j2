<!doctype html>
<html lang="en">
<body style="margin:0;padding:24px 16px;background:#f6f6f4;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1c1c1a;">
  <div style="max-width:560px;margin:0 auto;background:#ffffff;padding:28px;border-radius:8px;">
    <p style="margin:0 0 16px;font-size:20px;font-weight:600;line-height:1.3;">{{ heading }}</p>
{% for line in lines %}
    <p style="margin:0 0 16px;font-size:16px;line-height:1.5;">{{ line }}</p>
{% endfor %}

    <p style="margin:8px 0 24px;">
      <a href="{{ cta_url }}" style="display:inline-block;padding:12px 20px;background:#1c1c1a;color:#ffffff;text-decoration:none;border-radius:6px;font-size:15px;font-weight:600;">{{ cta_label }}</a>
    </p>

    <p style="margin:0;padding-top:16px;border-top:1px solid #e4e4df;font-size:12px;line-height:1.5;color:#8a8a84;">
{% if ai_written %}
      This email was written with AI assistance on behalf of {{ brand_name }}.<br>
{% endif %}
{% if unsubscribe_url %}
      Don't want brand offers? <a href="{{ unsubscribe_url }}" style="color:#8a8a84;">Unsubscribe</a>
{% else %}
      Sent by Collabio.
{% endif %}
    </p>
  </div>
</body>
</html>
