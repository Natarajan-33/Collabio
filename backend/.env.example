# Copy to backend/.env and fill in the secrets. backend/.env is git-ignored.

# Supabase (local stack from `supabase start`; keys from `supabase status -o env`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json

# Gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-2

# ElevenLabs
ELEVENLABS_API_KEY=

# CORS: the frontend origin allowed to call the API with credentials
FRONTEND_ORIGIN=http://localhost:3000

# Demo accounts created by the seed script
DEMO_BRAND_EMAIL=
DEMO_PASSWORD=
DEMO_HELPER_PHONE=
DEMO_HELPER_EMAIL=
