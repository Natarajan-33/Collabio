<!doctype html>
<html lang="en">
<body style="margin:0;padding:24px 16px;background:#f6f6f4;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1c1c1a;">
  <div style="max-width:560px;margin:0 auto;background:#ffffff;padding:28px;border-radius:8px;">
    <p style="margin:0 0 16px;font-size:16px;line-height:1.5;">Hi {{ first_name }},</p>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.5;">{{ draft.opener }}</p>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.5;">{{ draft.ask_paragraph }}</p>
    <p style="margin:0 0 20px;font-size:16px;line-height:1.5;">{{ draft.rationale }}</p>

    <p style="margin:0 0 8px;font-size:13px;font-weight:600;letter-spacing:0.04em;text-transform:uppercase;color:#6b6b66;">Your package vs. this ask</p>
    <table role="presentation" cellspacing="0" cellpadding="0" style="width:100%;border-collapse:collapse;margin:0 0 24px;font-size:15px;line-height:1.4;">
      <tr>
        <td style="padding:8px 12px 8px 0;border-top:1px solid #e4e4df;color:#6b6b66;white-space:nowrap;">Videos</td>
        <td style="padding:8px 0;border-top:1px solid #e4e4df;">{{ listed_videos }} in &quot;{{ package_name }}&quot; &middot; asking for {{ ask_videos }}</td>
      </tr>
      <tr>
        <td style="padding:8px 12px 8px 0;border-top:1px solid #e4e4df;color:#6b6b66;white-space:nowrap;">Price</td>
        <td style="padding:8px 0;border-top:1px solid #e4e4df;">{{ listed_price }} listed for {{ ask_videos }} &middot; offering {{ ask_price }}</td>
      </tr>
      <tr>
        <td style="padding:8px 12px 8px 0;border-top:1px solid #e4e4df;border-bottom:1px solid #e4e4df;color:#6b6b66;white-space:nowrap;">Go live by</td>
        <td style="padding:8px 0;border-top:1px solid #e4e4df;border-bottom:1px solid #e4e4df;">{{ go_live_by }}</td>
      </tr>
    </table>

    <p style="margin:0 0 12px;">
      <a href="{{ offer_url }}" style="display:inline-block;padding:12px 20px;background:#1c1c1a;color:#ffffff;text-decoration:none;border-radius:6px;font-size:15px;font-weight:600;">Review &amp; respond in Collabio</a>
    </p>
    <p style="margin:0 0 24px;font-size:14px;line-height:1.5;color:#6b6b66;">Or simply reply to this email.</p>

    <p style="margin:0 0 24px;font-size:15px;line-height:1.5;">&mdash; {{ brand_name }} (via Collabio)</p>

    <p style="margin:0;padding-top:16px;border-top:1px solid #e4e4df;font-size:12px;line-height:1.5;color:#8a8a84;">
      This email was written with AI assistance on behalf of {{ brand_name }}.<br>
      Don't want brand offers? <a href="{{ unsubscribe_url }}" style="color:#8a8a84;">Unsubscribe</a>
    </p>
  </div>
</body>
</html>
