# Copy to backend/.env and fill in the secrets. backend/.env is git-ignored.

# Supabase: the hosted project (Dashboard > Project Settings > API, and Connect).
# Replace <project-ref>, <password> and <region> with your project's values.
SUPABASE_URL=https://<project-ref>.supabase.co
# The project's secret key (sb_secret_...). Server only.
SUPABASE_SECRET_KEY=
# The SESSION POOLER string (Connect > Session pooler), not the direct db.<project-ref> host,
# which is IPv6-only. URL-encode special characters in the password.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2

# ElevenLabs
ELEVENLABS_API_KEY=

# CORS: the frontend origin allowed to call the API with credentials
FRONTEND_ORIGIN=http://localhost:3000

# Demo accounts created by the seed script
DEMO_BRAND_EMAIL=
DEMO_PASSWORD=
DEMO_HELPER_PHONE=
DEMO_HELPER_EMAIL=
