# Public, non-secret values only: every NEXT_PUBLIC_ variable is inlined into the
# browser bundle. Never put a Supabase secret key or any API key in the frontend.
# Copy to .env.local (git-ignored) to run the app.
NEXT_PUBLIC_SUPABASE_URL=https://jilkhalmsumjwfuteolz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xEGwq5MIoHUWedwpKhQ08Q_TB4xGQi6
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo walkthrough. Set NEXT_PUBLIC_DEMO_MODE to 1 and the sign-in page lists the seeded
# demo accounts (emails only, never a password). Leave it 0 anywhere that is not a demo.
NEXT_PUBLIC_DEMO_MODE=0
# The accounts to list: the same values the backend seed ran with (backend/.env). Server
# only, so no NEXT_PUBLIC_ prefix, and read on every request. The second creator, Arjun,
# is derived as local+arjun@domain from the helper email, as the seed does. If both are
# empty the hint is hidden.
DEMO_BRAND_EMAIL=
DEMO_HELPER_EMAIL=

# M4 hackathon mode (PayPal AI Hackathon)
NEXT_PUBLIC_HACKATHON_MODE=0
# Server-only: the demo personas sign in with this shared password (never sent to the browser).
DEMO_PASSWORD=
# Sandbox-only PayPal buyer shown in the judge guide (intentionally public; no real money).
NEXT_PUBLIC_JUDGE_BUYER_EMAIL=
NEXT_PUBLIC_JUDGE_BUYER_PASSWORD=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# AG Studio licence and the Claude key for the dashboard agent (server-only).
AG_STUDIO=
ANTHROPIC_API_KEY=
