# Copy to backend/.env and fill in the secrets. backend/.env is git-ignored.

# Supabase: the hosted project (Dashboard > Project Settings > API, and Connect).
# Replace <project-ref>, <password> and <region> with your project's values.
SUPABASE_URL=https://<project-ref>.supabase.co
# The project's secret key (sb_secret_...). Server only.
SUPABASE_SECRET_KEY=
# The SESSION POOLER string (Connect > Session pooler), not the direct db.<project-ref> host,
# which is IPv6-only. URL-encode special characters in the password.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Gemini
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-2

# ElevenLabs
ELEVENLABS_API_KEY=
# Agent ids printed by `python -m scripts.sync_agents` (one per agent)
ELEVENLABS_BRIEF_AGENT_ID=
ELEVENLABS_NEGOTIATION_AGENT_ID=
# The Twilio/SIP phone number the negotiation agent dials from
ELEVENLABS_PHONE_NUMBER_ID=
# Signs ElevenLabs post-call webhooks (HMAC secret from the ElevenLabs dashboard)
ELEVENLABS_WEBHOOK_SECRET=
# Shared secret ElevenLabs sends to the negotiation agent's server tools
ELEVENLABS_TOOL_SECRET=

# Resend (outreach email + Try it → Email me). No ENQUIRY_TO — Collabio sends to each
# creator (or the address someone types in the demo), not a fixed inbox.
RESEND_API_KEY=
# Verified-domain sender, e.g. "Tenvexa Labs <enquiries@tenvexalabs.in>"
RESEND_FROM=
# Domain whose inbound email Resend forwards to this backend (reply-to addresses)
RESEND_INBOUND_DOMAIN=
# Signing secret (whsec_...) of the Resend email.received webhook
RESEND_WEBHOOK_SECRET=

# Public HTTPS tunnel or deploy URL; ElevenLabs calls the tool webhooks here
PUBLIC_BACKEND_URL=http://localhost:8000
# Public HTTPS tunnel or deploy URL; emailed "Review & respond" links point here
PUBLIC_FRONTEND_URL=http://localhost:3000
# Set to 0 to stop the background workers (e.g. while running tests against the shared database)
WORKERS_ENABLED=1
# 1 shows the seeded fictional creators (development only). Leave unset/0 in production.
DEMO_MODE=1

# CORS: browser origin(s) allowed to call the API (comma-separated production URLs)
FRONTEND_ORIGIN=http://localhost:3000
# Optional: Vercel preview deploys get a new host each time — e.g. collabio-*.vercel.app
# FRONTEND_ORIGIN_REGEX=https://collabio-.*\.vercel\.app

# Demo accounts created by the seed script
DEMO_BRAND_EMAIL=
DEMO_PASSWORD=
DEMO_HELPER_PHONE=
DEMO_HELPER_EMAIL=
